{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{
					"slug": "surface",
					"color": "#14111a",
					"name": "Surface"
				},
				{
					"slug": "surface-alt",
					"color": "#1d1926",
					"name": "Surface alt"
				},
				{
					"slug": "text",
					"color": "#ece8f0",
					"name": "Text"
				},
				{
					"slug": "muted",
					"color": "#a79fb5",
					"name": "Muted"
				},
				{
					"slug": "accent",
					"color": "#ff8a65",
					"name": "Accent"
				},
				{
					"slug": "accent-ink",
					"color": "#1a1420",
					"name": "Accent ink"
				},
				{
					"slug": "border",
					"color": "#2a2536",
					"name": "Border"
				},
				{
					"slug": "border-strong",
					"color": "#6e618d",
					"name": "Border strong"
				},
				{
					"slug": "danger",
					"color": "#ff6b6b",
					"name": "Danger"
				}
			]
		},
		"typography": {
			"fluid": false,
			"defaultFontSizes": false,
			"customFontSize": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "\"Space Grotesk\", \"Space Grotesk Fallback\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Space Grotesk",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/space-grotesk-latin-400-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Space Grotesk",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/space-grotesk-latin-600-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "heading",
					"name": "Heading",
					"fontFamily": "\"Space Grotesk\", \"Space Grotesk Fallback\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "\"IBM Plex Mono\", \"IBM Plex Mono Fallback\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
					"fontFace": [
						{
							"fontFamily": "IBM Plex Mono",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/ibm-plex-mono-latin-400-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "IBM Plex Mono",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/ibm-plex-mono-latin-600-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "XS",
					"size": "13px"
				},
				{
					"slug": "medium",
					"name": "S",
					"size": "15px"
				},
				{
					"slug": "large",
					"name": "Base",
					"size": "17px"
				},
				{
					"slug": "x-large",
					"name": "M",
					"size": "19px"
				},
				{
					"slug": "xx-large",
					"name": "L",
					"size": "28px"
				},
				{
					"slug": "display",
					"name": "2XL",
					"size": "52px"
				}
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"spacingScale": {
				"steps": 0
			},
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw",
				"vh"
			],
			"spacingSizes": [
				{
					"slug": "10",
					"name": "1",
					"size": "4px"
				},
				{
					"slug": "20",
					"name": "2",
					"size": "8px"
				},
				{
					"slug": "30",
					"name": "3",
					"size": "16px"
				},
				{
					"slug": "40",
					"name": "4",
					"size": "24px"
				},
				{
					"slug": "50",
					"name": "5",
					"size": "40px"
				},
				{
					"slug": "60",
					"name": "6",
					"size": "64px"
				},
				{
					"slug": "70",
					"name": "7",
					"size": "96px"
				},
				{
					"slug": "80",
					"name": "8",
					"size": "144px"
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "sm",
					"name": "Small",
					"shadow": "0 1px 2px rgba(0, 0, 0, 0.35)"
				},
				{
					"slug": "md",
					"name": "Medium",
					"shadow": "0 12px 32px rgba(0, 0, 0, 0.4)"
				}
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"custom": {
			"container": {
				"padding": "24px"
			},
			"measure": {
				"content": "560px",
				"wide": "820px"
			},
			"radius": {
				"small": "2px",
				"medium": "4px",
				"large": "6px"
			},
			"transition": {
				"fast": "300ms ease",
				"base": "400ms ease"
			},
			"backdrop": "rgba(10, 8, 14, 0.68)"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--surface)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--large)",
			"fontWeight": "400",
			"lineHeight": "1.5"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--30)",
			"padding": {
				"left": "var(--wp--custom--container--padding)",
				"right": "var(--wp--custom--container--padding)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600",
					"lineHeight": "1.15",
					"letterSpacing": "-0.01em"
				},
				"color": {
					"text": "var(--wp--preset--color--text)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)",
					"lineHeight": "1.08"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"textTransform": "uppercase",
					"letterSpacing": "0.08em"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					},
					"typography": {
						"textDecoration": "none"
					}
				}
			},
			"button": {
				"border": {
					"radius": "var(--wp--custom--radius--medium)",
					"width": "1.5px",
					"style": "solid",
					"color": "var(--wp--preset--color--accent)"
				},
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--accent-ink)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"lineHeight": "1"
				},
				"spacing": {
					"padding": {
						"top": "14px",
						"bottom": "14px",
						"left": "26px",
						"right": "26px"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--text)"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--accent)"
							},
							"typography": {
								"textDecoration": "none"
							}
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "400"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--muted)"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--accent)"
							},
							"typography": {
								"textDecoration": "none"
							}
						}
					}
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--text)"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--accent)"
							},
							"typography": {
								"textDecoration": "none"
							}
						}
					}
				}
			},
			"core/post-terms": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/query-pagination": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/code": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
