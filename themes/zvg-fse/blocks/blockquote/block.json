{
	"$schema": "https://schemas.wp.org/wp/6.7/block.json",
	"apiVersion": 3,
	"name": "zvg-fse/blockquote",
	"title": "ZVG Blockquote",
	"category": "text",
	"icon": "format-quote",
	"description": "A quote card with an oversized quote mark, the quote itself and an optional author name and role.",
	"keywords": [ "quote", "blockquote", "testimonial", "citation" ],
	"textdomain": "zvg-fse",
	"style": "file:./style.css",
	"render": "file:./block.php",
	"attributes": {
		"text": {
			"type": "string",
			"default": ""
		},
		"authorName": {
			"type": "string",
			"default": ""
		},
		"authorRole": {
			"type": "string",
			"default": ""
		}
	},
	"example": {
		"attributes": {
			"text": "The three builds share one design token set. What differs is who can change what, and how easily.",
			"authorName": "Marta Lindqvist",
			"authorRole": "Content strategist"
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true
		}
	}
}
