{
	"$schema": "https://schemas.wp.org/wp/6.7/block.json",
	"apiVersion": 3,
	"name": "zvg-fse/compare-table",
	"title": "ZVG Compare Table",
	"category": "text",
	"icon": "editor-table",
	"description": "A comparison table whose row labels are headers and stay in place while the columns scroll.",
	"keywords": [ "table", "comparison", "measurements" ],
	"textdomain": "zvg-fse",
	"style": "file:./style.css",
	"render": "file:./block.php",
	"attributes": {
		"caption": {
			"type": "string",
			"role": "content",
			"default": ""
		},
		"columns": {
			"type": "array",
			"role": "content",
			"default": [ "FSE", "Elementor", "ACF theme" ],
			"items": {
				"type": "string"
			}
		},
		"rows": {
			"type": "array",
			"role": "content",
			"default": [
				{
					"label": "Lines of code",
					"values": [ "", "", "" ]
				},
				{
					"label": "Page weight",
					"values": [ "", "", "" ]
				},
				{
					"label": "DOM nodes",
					"values": [ "", "", "" ]
				},
				{
					"label": "Lighthouse mobile",
					"values": [ "", "", "" ]
				}
			],
			"items": {
				"type": "object"
			}
		}
	},
	"example": {
		"viewportWidth": 900,
		"attributes": {
			"caption": "Four checks compared across the three builds.",
			"columns": [ "FSE", "Elementor", "ACF theme" ],
			"rows": [
				{
					"label": "Lines of code",
					"values": [ "6955", "—", "—" ]
				},
				{
					"label": "Page weight",
					"values": [ "476 KB", "—", "—" ]
				},
				{
					"label": "DOM nodes",
					"values": [ "577", "—", "—" ]
				}
			]
		}
	},
	"supports": {
		"html": false,
		"spacing": {
			"margin": true
		}
	}
}
