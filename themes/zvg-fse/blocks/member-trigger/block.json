{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "zvg-fse/member-trigger",
	"title": "ZVG Member Profile",
	"category": "theme",
	"icon": "id-alt",
	"description": "Carries the member profile and the button that opens it in the dialog. Without JavaScript the profile stays on the card.",
	"keywords": [ "team", "member", "profile", "dialog" ],
	"textdomain": "zvg-fse",
	"usesContext": [ "postId" ],
	"ancestor": [ "core/post-template" ],
	"render": "file:./block.php",
	"attributes": {
		"toggleLabel": {
			"type": "string",
			"role": "content",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	}
}
