{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "zvg-fse/member-dialog",
	"title": "ZVG Member Dialog",
	"category": "theme",
	"icon": "external",
	"description": "The dialog the team cards open, filled from the card that opened it.",
	"keywords": [ "team", "member", "profile", "dialog" ],
	"textdomain": "zvg-fse",
	"style": "file:./style.css",
	"render": "file:./block.php",
	"attributes": {
		"closeLabel": {
			"type": "string",
			"role": "content",
			"default": ""
		},
		"linkText": {
			"type": "string",
			"role": "content",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	}
}
