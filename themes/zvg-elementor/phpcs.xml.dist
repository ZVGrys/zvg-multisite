<?xml version="1.0"?>
<ruleset name="ZVG Elementor">
	<description>Coding standards for the ZVG Elementor theme.</description>

	<file>.</file>

	<exclude-pattern>*/cmb2/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="zvg-elementor"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_wp_version" value="6.7"/>
</ruleset>
