<?xml version="1.0"?>
<ruleset name="ZVG ACF">
	<description>Coding standards for the ZVG ACF theme.</description>

	<file>.</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="zvg-acf"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_wp_version" value="6.7"/>
</ruleset>
