# Ignore everything at the repository root...
/*

# ...and the contents of the folders reopened below.
themes/*

# ...and these at any depth.
node_modules/
*.map
debug.log
*.log
*.sql
*.zip
.env
.idea
.vscode
.DS_Store


# But not these files...
!/.gitignore
!/README.md
!/LICENSE

# The screenshots the README shows.
!/docs/
!/docs/img/*.png
!/docs/img/*.webp

# The fatal-error template. A drop-in, so it has to sit at the wp-content root, but it is ours
# and it carries the site's identity — it belongs in version control like any other template.
!/php-error.php

# Reopen the folder first — /* above excluded it, and git cannot re-include a
# file whose parent directory is still excluded.
!/themes/
!themes/zvg-fse
!themes/zvg-acf
!themes/zvg-elementor

# The build itself — one toolchain for all three themes, sitting above them.
!themes/gulpfile.js
!themes/package.json
!themes/package-lock.json

# The coding-standards and static-analysis toolchain, alongside the build. themes/vendor/ stays
# ignored by themes/* above, exactly as node_modules/ does.
!themes/composer.json
!themes/composer.lock
!themes/phpstan.neon.dist
!themes/phpstan/

# The workflows that run those standards on every pull request.
!/.github/
